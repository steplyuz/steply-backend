# =============================================================================
# Steply Backend — muhit o'zgaruvchilari (.env)
#
# Qoidalar:
#   * Bu fayl Settings maydonlarining AYNAN ro'yxati (tests/test_stage8_quality.py
#     tekshiradi). Yangi maydon qo'shsangiz, shu yerga ham qo'shing.
#   * Har bo'lim sarlavhasida: [PROD] — productionda majburiy; [FEATURE] — faqat
#     tegishli funksiya yoqilganda kerak; [DEFAULT] — o'zgartirish shart emas.
#   * Sirlar (SECRET_KEY, tokenlar, parollar, API kalitlar) repoga yozilmaydi.
#     Bu fayl nusxa sifatida .env ga ko'chiriladi va u .gitignore ga kiritilgan bo'lishi shart.
#   * Ro'yxatdan o'tish SMS'ni yoqish/o'chirish va to'lov rekvizitlari .env'da
#     emas — admin paneldan (DB) boshqariladi.
# =============================================================================

# ---- 1. Asosiy [PROD] --------------------------------------------------------
ENV=local
PROJECT_NAME=Mock Center API
DEBUG=false
# Productionda false: schema faqat Alembic orqali yaratiladi (alembic upgrade head)
AUTO_CREATE_SCHEMA=false
# Productionda absolyut, public bo'lmagan yo'l
# (masalan sqlite+aiosqlite:////home/app/storage/private/mock_center.db)
DATABASE_URL=sqlite+aiosqlite:///./mock_center.db

# ---- 2. Sirlar [PROD] — kamida 32 belgili tasodifiy qiymat -------------------
# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_ENV
ADMIN_SECRET_KEY=CHANGE_ME_ADMIN_SECRET
# Bot -> backend ichki chaqiruvlar uchun token (bot.py va billing review)
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# ---- 3. Domen, CORS, host [PROD] ---------------------------------------------
# Vergul bilan. Faqat aniq hostlar; productionda wildcard va localhost taqiqlangan
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Vergul bilan. Productionda faqat aniq HTTPS originlar
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_DOMAIN=steply.uz
# Frontend manzili. Productionda HTTPS (inPAY return_url shu asosda quriladi)
FRONTEND_URL=http://localhost:3000
# Productionda HTTPS (audio/fayl havolalari uchun). Bo'sh — joriy host
PUBLIC_BASE_URL=
# Public, immutable media (Nginx)
MEDIA_DOMAIN=https://static.steply.uz
# Faqat ishonchli reverse-proxy (nginx) ortida true; aks holda IP cheklovlari soxtalashadi
TRUST_PROXY_HEADERS=false

# ---- 4. Cookie va token [PROD] -----------------------------------------------
# Productionda ikkalasi ham true bo'lishi shart (HTTPS)
COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_SECURE=false
# lax — same-site uchun standart. "none" faqat haqiqiy cross-site frontend bo'lsa
COOKIE_SAMESITE=lax
# Cookie domeni (URL emas). Bo'sh — joriy host
COOKIE_DOMAIN=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---- 5. Admin panel [PROD] ---------------------------------------------------
# Vergul bilan IP ro'yxati. Bo'sh — cheklov yo'q (ogohlantirish beriladi)
ADMIN_ALLOWED_IPS=

# ---- 6. Rate limit [PROD] ----------------------------------------------------
# Bir nechta worker bo'lsa redis://host:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# ---- 7. Saqlash [DEFAULT] ----------------------------------------------------
PRIVATE_STORAGE_DIR=storage/private
LISTENING_AUDIO_DIR=storage/private/listening_audio
SPEAKING_ALLOWED_AUDIO_EXTENSIONS=.mp3,.m4a,.wav,.ogg,.webm
SPEAKING_MAX_AUDIO_MB=25

# ---- 8. Telegram bot [FEATURE: Telegram bot va to'lov tasdiqlash] ------------
# @BotFather dan. Bot alohida jarayon: `python bot.py` (docs/DEPLOY.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=steply_bot
# Faqat lokal dev uchun. Productionda false
RUN_TELEGRAM_BOT_IN_API=false
# Chek keladigan admin guruh chat ID'si (ko'pincha manfiy son, masalan -100...)
TELEGRAM_BILLING_ADMIN_CHAT_ID=
# Tasdiqlash tugmasini bosishi mumkin bo'lgan adminning Telegram user ID'si.
# Shu admin Steply'da Telegram bilan kirgan bo'lishi kerak
TELEGRAM_BILLING_ADMIN_TELEGRAM_USER_ID=

# ---- 9. Telegram Login (OIDC) [FEATURE: Telegram bilan kirish] ---------------
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Bitta URI. Telegram kabinetidagi ro'yxatdan o'tgan manzil bilan aynan bir xil bo'lsin
TELEGRAM_REDIRECT_URI=
TELEGRAM_OIDC_STATE_TTL_SECONDS=600
TELEGRAM_OIDC_HTTP_TIMEOUT_SECONDS=10.0
TELEGRAM_OIDC_CLOCK_SKEW_SECONDS=60

# ---- 10. Google Sign-In [FEATURE: Google bilan kirish] ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_HTTP_TIMEOUT_SECONDS=10.0

# ---- 11. SMS (Eskiz) [FEATURE: SMS kod / natija SMS] ------------------------
# SMS ro'yxatdan o'tish yoqilgan-yoqilmaganligi — admin paneldan (DB)
SMS_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Natija tayyor bo'lganda SMS yuborish (ESKIZ_* kerak)
RESULT_SMS_ENABLED=false
RESULT_SMS_SENDER=4546

# ---- 12. Ichki servislar [DEFAULT] -------------------------------------------
# (INTERNAL_API_TOKEN yuqorida, 2-bo'limda)

# ---- 13. Exams kirish (nomzod) [DEFAULT] -------------------------------------
# MK ID bilan kirish zaif (1000 variant/sana). Frontend exam_access_id ga o'tgach false
EXAMS_MK_ID_LOGIN_ENABLED=false
# MK ID bilan kirishda telefonning oxirgi 4 raqami talab qilinadi
EXAMS_MK_ID_REQUIRE_PHONE_LAST4=true
# Kirish oynasi (daqiqa). Bo'sh bo'lsa tekshirilmaydi
EXAMS_LOGIN_OPENS_MINUTES_BEFORE=5
EXAMS_LOGIN_CLOSES_MINUTES_AFTER=5

# ---- 14. Ochiq /apply CAPTCHA [PROD: true bo'lishi shart] --------------------
APPLY_CAPTCHA_ENABLED=false
# Cloudflare Turnstile. APPLY_CAPTCHA_ENABLED=true bo'lsa majburiy
TURNSTILE_SECRET_KEY=

# ---- 15. AI baholash (Writing AI / Speaking AI) [FEATURE] --------------------
# Chat (baholash) uchun. Bo'sh bo'lsa AI baholash ishlamaydi.
# base_url oxiri /v1 bo'lishi kerak (masalan https://api.openai.com/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Speaking AI baholashni yoqish. Yoqilsa OPENAI_API_KEY majburiy
SPEAKING_AI_ENABLED=false
# Bo'sh bo'lsa OPENAI_MODEL ishlatiladi
SPEAKING_AI_MODEL=
# Transkripsiya (STT). Bo'sh STT_BASE_URL bo'lsa OPENAI_BASE_URL ishlatiladi.
# Eslatma: whisper-1 faqat OpenAI'da bor — boshqa provayderda STT_BASE_URL ni OpenAI'ga yo'naltiring
# STT provayderi: openai (OpenAI-mos API) yoki aws (Amazon Transcribe, S3 orqali)
# openai | aws | local (local: faster-whisper, API kaliti kerak emas; birinchi ishga tushirishda model yuklanadi)
STT_PROVIDER=openai
# --- STT_PROVIDER=local bo'lsa ---
# tiny | base | small | medium (katta = aniqroq, sekinroq)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_BASE_URL=
# Transkripsiya kaliti (OpenAI). Bo'sh bo'lsa OPENAI_API_KEY ishlatiladi
STT_API_KEY=
STT_MODEL=whisper-1
# --- STT_PROVIDER=aws bo'lsa ---
AWS_REGION=us-east-1
# Bo'sh bo'lsa boto3 standart zanjiri (IAM role, ~/.aws) ishlatiladi
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Audio vaqtincha yoziladigan S3 bucket (IAM: s3:PutObject/GetObject/DeleteObject, transcribe:*)
AWS_TRANSCRIBE_BUCKET=
AWS_TRANSCRIBE_LANGUAGE=en-US

# ---- 16. inPAY (avtomatik onlayn to'lov) [FEATURE] ---------------------------
# false bo'lsa buyurtmalar admin chek tekshiruvi orqali ishlaydi
INPAY_ENABLED=false
INPAY_API_BASE=https://inpay.uz/api/v2
# sk_test_... (sinov) yoki sk_live_... (jonli)
INPAY_SECRET_KEY=
# whsec_... — kassa webhook imzo siri (GET /webhooks/secret/, faqat sk_live_ bilan)
INPAY_WEBHOOK_SECRET=
# Ommaviy https manzil: https://<domen>/api/v1/billing/inpay/webhook (localhost ishlamaydi)
INPAY_WEBHOOK_URL=
# Frontend: https://<domen>/dashboard/billing (?order=... avtomatik qo'shiladi)
INPAY_RETURN_URL=
INPAY_WEBHOOK_TOLERANCE_SECONDS=300
